# Variables de entorno de Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
SUPABASE_JWT_SECRET=tu-jwt-secret-aqui

# Servidor local
PORT=8765

# Base de datos (conexion directa Postgres, opcional)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Ngrok Key
NGROK_AUTHTOKEN=tu-token-de-ngrok

# Telegram
TELEGRAM_BOT_TOKEN=tu-token-del-bot
TELEGRAM_WEBHOOK_SECRET_TOKEN=tu-secret-para-webhook
TELEGRAM_BOT_USERNAME=TuBotUsername

# LLM
LLM_API_KEY=llm-api-key